--
-- Table structure for table `silinen_personel_kartlari`
--

CREATE TABLE silinen_personel_kartlari (
  id int(11) unsigned NOT NULL auto_increment,
  sicilno varchar(13) default NULL,
  sskno varchar(13) default NULL,
  kartno varchar(16) NOT NULL default '',
  diger_kartno varchar(30) default NULL,
  adi varchar(20) default NULL,
  soyadi varchar(20) default NULL,
  unvani varchar(20) default NULL,
  sirket_kod tinyint(4) unsigned default NULL,
  bolum_kod tinyint(4) unsigned default NULL,
  departman_kod tinyint(4) unsigned default NULL,
  ozel_kod tinyint(4) unsigned default NULL,
  hesap_kod int(11) default NULL,
  eskimaasi float(12,2) default NULL,
  netmaasi float(12,2) unsigned default NULL,
  gunlukucreti float(12,2) default NULL,
  saatucreti_1 float(12,5) default NULL,
  saatucreti_2 float(12,5) default NULL,
  saatucreti_3 float(12,5) default NULL,
  durumkodu tinyint(4) unsigned default '0',
  note text,
  giristarihi date NOT NULL default '0000-00-00',
  cikistarihi date default NULL,
  personelresmi blob,
  kimlik_seri varchar(4) default NULL,
  kimlik_no varchar(10) default NULL,
  babaad varchar(20) default NULL,
  anaad varchar(20) default NULL,
  mernis_no varchar(16) default NULL,
  kan_gurup varchar(8) default NULL,
  dogum_yer varchar(20) default NULL,
  dogum_tarih date default NULL,
  medeni_durum varchar(10) default NULL,
  ikametgah_adres varchar(80) default NULL,
  ikametgah_il varchar(20) default NULL,
  ikametgah_ilce varchar(20) default NULL,
  ikametgah_pkod varchar(6) default NULL,
  ev_telefon varchar(16) default NULL,
  cep_telefon varchar(16) default NULL,
  email varchar(40) default NULL,
  ev_durum enum('Kendi','Kira','Lojman') default NULL,
  kira_bedel float(12,2) default NULL,
  giysi_beden tinyint(4) unsigned default NULL,
  ceket_bedeni varchar(10) default NULL,
  pantolon_bedeni varchar(10) default NULL,
  gomlek_bedeni varchar(10) default NULL,
  ayakkabi_no tinyint(4) unsigned default NULL,
  ogrenim_durumu varchar(15) default NULL,
  servis_kod tinyint(15) default NULL,
  cinsiyet tinyint(4) default NULL,
  Agi float(12,2) unsigned default '0.00',
  yillik_izin_hakki smallint(2) default '0',
  yillik_izin_kullanilan smallint(2) default '0',
  PRIMARY KEY  (id),
  UNIQUE KEY kartno (kartno)
) TYPE=MyISAM;

