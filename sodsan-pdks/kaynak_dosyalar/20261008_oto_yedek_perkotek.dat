--
-- Table structure for table `silinen_personel_maas`
--

CREATE TABLE silinen_personel_maas (
  id int(11) unsigned NOT NULL auto_increment,
  personel_id int(11) unsigned NOT NULL default '0',
  tarih date NOT NULL default '0000-00-00',
  ucret float(15,5) NOT NULL default '0.00000',
  PRIMARY KEY  (id)
) TYPE=MyISAM;

