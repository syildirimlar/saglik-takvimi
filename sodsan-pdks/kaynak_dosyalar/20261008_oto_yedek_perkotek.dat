--
-- Table structure for table `silinen_personel_izin`
--

CREATE TABLE silinen_personel_izin (
  id int(11) unsigned NOT NULL auto_increment,
  personel_id int(11) unsigned NOT NULL default '0',
  tatil_id int(11) default NULL,
  tarih date NOT NULL default '0000-00-00',
  gidis_saat time NOT NULL default '00:00:00',
