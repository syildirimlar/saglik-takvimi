--
-- Table structure for table `silinen_personel_giriscikis`
--

CREATE TABLE silinen_personel_giriscikis (
  id int(11) unsigned NOT NULL auto_increment,
  personel_id int(11) unsigned NOT NULL default '0',
  tarih date NOT NULL default '0000-00-00',
  giris_saat time default NULL,
  cikis_saat time default NULL,
  elle_giris tinyint(1) default '0',
  elle_cikis tinyint(1) default '0',
  giris_kapi tinyint(4) unsigned default '0',
  cikis_kapi tinyint(4) unsigned default '0',
  vardiya tinyint(4) default '-1',
  nedenkodu int(11) default '0',
  PRIMARY KEY  (id)
) TYPE=MyISAM;

