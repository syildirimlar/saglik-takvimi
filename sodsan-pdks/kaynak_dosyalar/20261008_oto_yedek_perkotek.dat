CREATE TABLE tatil_tablo (
  id int(11) unsigned NOT NULL auto_increment,
  aciklama char(30) default NULL,
  tatil_tipi tinyint(4) NOT NULL default '0',
  hakedilen_sure time default NULL,
  hakedilen_bordro_id int(11) default NULL,
  hesap_tipi tinyint(4) default NULL,
  sure_tipi tinyint(4) unsigned default '0',
  ucret_tipi tinyint(4) unsigned default '1',
  PRIMARY KEY  (id)
) TYPE=MyISAM;

