--
-- Table structure for table `silinen_personel_malzemeler`
--

CREATE TABLE silinen_personel_malzemeler (
  id int(11) unsigned NOT NULL auto_increment,
  personel_id int(11) unsigned NOT NULL default '0',
  BolumID int(11) default NULL,
  MalzemeID int(11) default NULL,
  aciklama char(100) default NULL,
  verilis_tarihi date default '2000-01-01',
  iade_tarihi date default NULL,
  PRIMARY KEY  (id)
) TYPE=MyISAM;

--
-- Dumping data for table `silinen_personel_malzemeler`
--


--
-- Table structure for table `silinen_personel_prim`
--

CREATE TABLE silinen_personel_prim (
  id int(11) unsigned NOT NULL auto_increment,
  personel_id int(11) unsigned NOT NULL default '0',
  tarih date NOT NULL default '0000-00-00',
  ucret float(12,2) NOT NULL default '0.00',
  oran smallint(6) default NULL,
  aciklama char(100) NOT NULL default '',
  bordro_id int(11) default NULL,
  PRIMARY KEY  (id)
) TYPE=MyISAM;

--
-- Dumping data for table `silinen_personel_prim`
--


--
-- Table structure for table `silinen_plan_ozel_detay`
--

CREATE TABLE silinen_plan_ozel_detay (
  id int(11) unsigned NOT NULL auto_increment,
  personel_id int(11) unsigned default NULL,
  tarih date default NULL,
  mesai_id int(11) default NULL,
  PRIMARY KEY  (id),
  KEY personel_id (personel_id)
) TYPE=MyISAM;

--
-- Dumping data for table `silinen_plan_ozel_detay`
