--
-- Table structure for table `silinen_puantaj_sonuc`
--

CREATE TABLE silinen_puantaj_sonuc (
  id int(11) unsigned NOT NULL auto_increment,
  personel_id int(11) unsigned default NULL,
  bordro_id smallint(6) unsigned default NULL,
  tarih date default NULL,
  giris time default NULL,
  cikis time default NULL,
  miktar float(9,3) default NULL,
  dakika smallint(6) default NULL,
  aciklama char(200) default NULL,
  satirno tinyint(4) default NULL,
  etkisiz_ucret tinyint(4) default '0',
  PRIMARY KEY  (id)
) TYPE=MyISAM;

