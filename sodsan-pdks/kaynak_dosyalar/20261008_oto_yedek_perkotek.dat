--
-- Table structure for table `personel_izin`
--

CREATE TABLE personel_izin (
  id int(11) unsigned NOT NULL auto_increment,
  personel_id int(11) unsigned NOT NULL default '0',
  tatil_id int(11) default NULL,
  tarih date NOT NULL default '0000-00-00',
  gidis_saat time NOT NULL default '00:00:00',
  gelis_saat time NOT NULL default '00:00:00',
  saatlik tinyint(4) unsigned NOT NULL default '0',
  aciklama char(100) NOT NULL default '',
  otoizin tinyint(4) default '0',
  PRIMARY KEY  (id),
  KEY tarih (tarih,gidis_saat,gelis_saat)
) TYPE=MyISAM;

